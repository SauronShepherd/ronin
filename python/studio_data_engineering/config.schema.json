{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_runtime": {
      "type": "string",
      "enum": ["local-preview", "spark-connect", "spark-sdp"]
    },
    "preview_row_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 100
    },
    "snapshot_policy": {
      "type": "string",
      "enum": ["disabled", "redacted", "full"],
      "default": "redacted"
    },
    "spark_connect_endpoint": {
      "type": "string",
      "pattern": "^sc://[^\\s]+$"
    },
    "sdp_studio_command": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "external_provider_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3600,
      "default": 60
    }
  }
}
