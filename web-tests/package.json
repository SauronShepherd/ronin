{
  "name": "ronin-web-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --grep-invert \"[Ll]ive\"",
    "test:live": "node tests/live-preflight.mjs && playwright test tests/live-runs.spec.mjs tests/ingestion-live.spec.mjs tests/product-live.spec.mjs --workers=1",
    "test:headed": "playwright test --headed --workers=1 --grep-invert \"[Ll]ive\"",
    "test:debug": "playwright test --debug --grep-invert \"[Ll]ive\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1"
  }
}
