{
  "openapi": "3.1.0",
  "info": {
    "title": "Ronin Control Plane API",
    "version": "0.1.0-alpha",
    "description": "Strict alpha /v1 contract. Response objects and semantic enums are closed; error-code values are open within the normalized error envelope. Static bearer credentials are bound server-side to typed project grants. See docs/product/API_COMPATIBILITY_V1.md and docs/product/AUTHORIZATION_GRANTS_V1.md."
  },
  "x-ronin-compatibility-stage": "alpha-strict",
  "x-ronin-authorization-model": "typed-project-grants-v1",
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/jobs": {
      "get": {
        "operationId": "listJobs",
        "x-ronin-required-project-actions": ["list"],
        "parameters": [
          {"name": "project", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
          {"name": "state", "in": "query", "schema": {"type": "string", "enum": ["queued", "running", "cancelling", "cancelled", "succeeded", "failed"]}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 4096, "x-maxBytes": 4096}}
        ],
        "responses": {
          "200": {"description": "Stable newest-first page containing only jobs visible to the bearer grant", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobPage"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      },
      "post": {
        "operationId": "submitJob",
        "x-ronin-required-project-actions": ["submit", "execute"],
        "parameters": [{"name": "Idempotency-Key", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitJobRequest"}}}},
        "responses": {
          "200": {"description": "Idempotent replay", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "x-ronin-required-project-actions": ["read"],
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "responses": {
          "200": {"description": "Current durable job status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs/{job_id}/events": {
      "get": {
        "operationId": "getJobEvents",
        "x-ronin-required-project-actions": ["events"],
        "parameters": [
          {"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
          {"name": "since", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 4096, "x-maxBytes": 4096}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}
        ],
        "responses": {
          "200": {"description": "Bounded Run-global event page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEventPage"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs/{job_id}/evidence": {
      "get": {
        "operationId": "getJobEvidence",
        "x-ronin-required-project-actions": ["evidence:read"],
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "responses": {
          "200": {"description": "Portable durable evidence references", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEvidence"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "x-ronin-required-project-actions": ["cancel"],
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "responses": {
          "200": {"description": "Cancellation requested or terminal job returned", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Static v0.1 bearer credential. The server binds the credential to a typed GrantSet; operation requirements are documented by x-ronin-required-project-actions. Direct job routes return 404 when the job is outside the credential's project authority."
      }
    },
    "schemas": {
      "SubmitJobRequest": {
        "type": "object", "additionalProperties": false, "required": ["project", "target"],
        "properties": {
          "project": {"type": "string", "minLength": 1, "maxLength": 256},
          "target": {"type": "string", "minLength": 1, "maxLength": 256},
          "parameters": {"type": "object", "additionalProperties": true, "default": {}}
        }
      },
      "Job": {
        "type": "object", "additionalProperties": false, "required": ["id", "state", "failure_code"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "state": {"type": "string", "enum": ["queued", "running", "cancelling", "cancelled", "succeeded", "failed"]},
          "failure_code": {"type": ["string", "null"]}
        }
      },
      "JobPage": {
        "type": "object", "additionalProperties": false, "required": ["items", "next_cursor"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/Job"}},
          "next_cursor": {"type": ["string", "null"], "maxLength": 4096, "x-maxBytes": 4096}
        }
      },
      "Instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
      "JobEvent": {
        "type": "object", "additionalProperties": false,
        "required": ["sequence", "attempt_id", "attempt_sequence", "kind", "message", "occurred_at"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "attempt_sequence": {"type": "integer", "minimum": 0},
          "kind": {"type": "string", "minLength": 1},
          "message": {"type": "string"},
          "occurred_at": {"$ref": "#/components/schemas/Instant"}
        }
      },
      "JobEventPage": {
        "type": "object", "additionalProperties": false, "required": ["items", "next_since"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/JobEvent"}},
          "next_since": {"type": "string", "minLength": 1, "maxLength": 4096, "x-maxBytes": 4096}
        }
      },
      "EvidenceAvailability": {"type": "string", "enum": ["available", "missing", "tombstoned", "unavailable"]},
      "EvidenceReference": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "cell_id", "role", "digest_algorithm", "digest", "media_type", "size_bytes", "availability", "reason"],
        "properties": {
          "version": {"const": 1},
          "cell_id": {"type": ["string", "null"]},
          "role": {"type": "string", "minLength": 1},
          "digest_algorithm": {"type": ["string", "null"]},
          "digest": {"type": ["string", "null"]},
          "media_type": {"type": ["string", "null"]},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "availability": {"$ref": "#/components/schemas/EvidenceAvailability"},
          "reason": {"type": ["string", "null"]}
        }
      },
      "JobEvidence": {
        "type": "object", "additionalProperties": false, "required": ["items"],
        "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/EvidenceReference"}}}
      },
      "Error": {
        "type": "object", "additionalProperties": false, "required": ["error"],
        "properties": {
          "error": {
            "type": "object", "additionalProperties": false, "required": ["code", "message"],
            "properties": {
              "code": {"type": "string", "minLength": 1, "maxLength": 128, "description": "Open error-code vocabulary; HTTP status remains authoritative."},
              "message": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "responses": {"Error": {"description": "Normalized error envelope", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}
  }
}
