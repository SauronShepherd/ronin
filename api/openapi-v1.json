{
  "openapi": "3.1.0",
  "info": {
    "title": "Ronin Control Plane API",
    "version": "0.1.0-alpha",
    "description": "Strict alpha /v1 contract. Response objects and semantic enums are closed; error-code values are open within the normalized error envelope. Static bearer credentials are bound server-side to typed project grants. See docs/product/API_COMPATIBILITY_V1.md and docs/product/AUTHORIZATION_GRANTS_V1.md."
  },
  "x-ronin-compatibility-stage": "alpha-strict",
  "x-ronin-authorization-model": "typed-project-grants-v1",
  "security": [{"bearerAuth": []}],
  "paths": {
    "/v1/sql": {
      "post": {
        "operationId": "executeSql",
        "x-ronin-required-project-actions": ["read"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SqlRequest"}}}},
        "responses": {
          "200": {"description": "Bounded read-only SQL result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SqlResult"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"},
          "504": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs": {
      "get": {
        "operationId": "listJobs",
        "x-ronin-required-project-actions": ["list"],
        "parameters": [
          {"name": "project", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
          {"name": "state", "in": "query", "schema": {"type": "string", "enum": ["queued", "running", "cancelling", "cancelled", "succeeded", "failed"]}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 4096, "x-maxBytes": 4096}}
        ],
        "responses": {
          "200": {"description": "Stable newest-first page containing only jobs visible to the bearer grant", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobPage"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      },
      "post": {
        "operationId": "submitJob",
        "x-ronin-required-project-actions": ["submit", "execute"],
        "parameters": [{"name": "Idempotency-Key", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SubmitJobRequest"}}}},
        "responses": {
          "200": {"description": "Idempotent replay", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "x-ronin-required-project-actions": ["read"],
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "responses": {
          "200": {"description": "Current durable job status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs/{job_id}/events": {
      "get": {
        "operationId": "getJobEvents",
        "x-ronin-required-project-actions": ["events"],
        "parameters": [
          {"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
          {"name": "since", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 4096, "x-maxBytes": 4096}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}
        ],
        "responses": {
          "200": {"description": "Bounded Run-global event page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEventPage"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs/{job_id}/evidence": {
      "get": {
        "operationId": "getJobEvidence",
        "x-ronin-required-project-actions": ["evidence:read"],
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "responses": {
          "200": {"description": "Portable durable evidence references", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobEvidence"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "x-ronin-required-project-actions": ["cancel"],
        "parameters": [{"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "responses": {
          "200": {"description": "Cancellation requested or terminal job returned", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Job"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/admin/security/principals/{principal_id}": {
      "put": {"operationId": "putSecurityPrincipal", "parameters": [{"name": "principal_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PrincipalRequest"}}}}, "responses": {"200": {"description": "Updated principal", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Principal"}}}}, "201": {"description": "Created principal", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Principal"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/security/groups/{group_id}": {
      "put": {"operationId": "putSecurityGroup", "parameters": [{"name": "group_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GroupRequest"}}}}, "responses": {"200": {"description": "Stored group", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Group"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/security/groups/{group_id}/members/{principal_id}": {
      "put": {"operationId": "addSecurityGroupMember", "parameters": [{"name": "group_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "principal_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Member added", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GroupMembership"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "delete": {"operationId": "removeSecurityGroupMember", "parameters": [{"name": "group_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "principal_id", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Member removal result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GroupMembership"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/admin/security/role-bindings/{subject_kind}/{subject_id}/{role}": {
      "put": {"operationId": "putSecurityRoleBinding", "parameters": [{"name": "subject_kind", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "subject_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "role", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Stored role binding", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoleBinding"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}},
      "delete": {"operationId": "deleteSecurityRoleBinding", "parameters": [{"name": "subject_kind", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "subject_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"name": "role", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Role binding removal result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RoleBinding"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}, {"name": "cursor", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 256}}],
        "responses": {"200": {"description": "Visible workspaces", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspacePage"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/workspaces/{workspace_id}": {
      "get": {
        "operationId": "getWorkspace",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "responses": {"200": {"description": "Workspace", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Workspace"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}
      },
      "patch": {
        "operationId": "updateWorkspace",
        "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkspaceUpdate"}}}},
        "responses": {"200": {"description": "Updated workspace", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Workspace"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/workspaces/{workspace_id}/archive": {
      "post": {"operationId": "archiveWorkspace", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "responses": {"200": {"description": "Archived workspace", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Workspace"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/workspaces/{workspace_id}/projects": {
      "get": {"operationId": "listProjects", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}, {"name": "cursor", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 256}}], "responses": {"200": {"description": "Workspace projects", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectPage"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}}},
      "post": {"operationId": "registerProject", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectManifest"}}}}, "responses": {"201": {"description": "Registered project", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectManifest"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/workspaces/{workspace_id}/projects/{project_id}": {
      "get": {"operationId": "getProject", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}], "responses": {"200": {"description": "Project manifest", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectManifest"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "put": {"operationId": "replaceProject", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectManifest"}}}}, "responses": {"200": {"description": "Replaced project", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectManifest"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}},
      "delete": {"operationId": "unregisterProject", "parameters": [{"$ref": "#/components/parameters/WorkspaceId"}, {"$ref": "#/components/parameters/ProjectId"}], "responses": {"200": {"description": "Unregistered project", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProjectUnregistration"}}}}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/workspaces/{workspace_id}/workflows": {
      "get": {
        "operationId": "listWorkflows",
        "parameters": [
          {"name": "workspace_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "minLength": 1, "maxLength": 256}}
        ],
        "responses": {
          "200": {"description": "Workspace workflow definitions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowPage"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/workspaces/{workspace_id}/workflows/{workflow_id}/runs": {
      "post": {
        "operationId": "createWorkflowRun",
        "parameters": [
          {"name": "workspace_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
          {"name": "workflow_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateWorkflowRunRequest"}}}},
        "responses": {
          "201": {"description": "Workflow run created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowRun"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/workspaces/{workspace_id}/workflow-runs/{run_id}": {
      "get": {
        "operationId": "getWorkflowRun",
        "parameters": [
          {"name": "workspace_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
          {"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}
        ],
        "responses": {
          "200": {"description": "Durable workflow run and task state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowRunDetail"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/workspaces/{workspace_id}/workflow-runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancelWorkflowRun",
        "parameters": [
          {"name": "workspace_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
          {"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}
        ],
        "responses": {
          "200": {"description": "Workflow cancellation result", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WorkflowCancellation"}}}},
          "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "WorkspaceId": {"name": "workspace_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}},
      "ProjectId": {"name": "project_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 256}}
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Static v0.1 bearer credential. The server binds the credential to a typed GrantSet; operation requirements are documented by x-ronin-required-project-actions. Direct job routes return 404 when the job is outside the credential's project authority."
      }
    },
    "schemas": {
      "SqlRequest": {
        "type": "object", "additionalProperties": false, "required": ["project", "sql"],
        "properties": {
          "project": {"type": "string", "minLength": 1, "maxLength": 256},
          "sql": {"type": "string", "minLength": 1, "maxLength": 1048576},
          "parameters": {"type": "array", "items": {"type": ["boolean", "integer", "number", "string", "null"]}, "default": []},
          "max_rows": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 10000}
        }
      },
      "SqlResult": {
        "type": "object", "additionalProperties": false, "required": ["columns", "rows"],
        "properties": {
          "columns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": {"name": {"type": "string"}, "type": {"type": "string"}}}},
          "rows": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/components/schemas/SqlWireScalar"}}}
        }
      },
      "SqlWireScalar": {
        "description": "JSON-safe SQL scalar. UTC timestamps use RFC 3339 with a Z suffix; decimal and UUID values are strings; binary values are standard Base64.",
        "oneOf": [
          {"type": "null"},
          {"type": "boolean"},
          {"type": "integer"},
          {"type": "number"},
          {"type": "string"}
        ]
      },
      "SubmitJobRequest": {
        "type": "object", "additionalProperties": false, "required": ["project", "target"],
        "properties": {
          "project": {"type": "string", "minLength": 1, "maxLength": 256},
          "target": {"type": "string", "minLength": 1, "maxLength": 256},
          "parameters": {"type": "object", "additionalProperties": true, "default": {}}
        }
      },
      "Job": {
        "type": "object", "additionalProperties": false, "required": ["id", "state", "failure_code"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "state": {"type": "string", "enum": ["queued", "running", "cancelling", "cancelled", "succeeded", "failed"]},
          "failure_code": {"type": ["string", "null"]}
        }
      },
      "JobPage": {
        "type": "object", "additionalProperties": false, "required": ["items", "next_cursor"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/Job"}},
          "next_cursor": {"type": ["string", "null"], "maxLength": 4096, "x-maxBytes": 4096}
        }
      },
      "Instant": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"},
      "JobEvent": {
        "type": "object", "additionalProperties": false,
        "required": ["sequence", "attempt_id", "attempt_sequence", "kind", "message", "occurred_at"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "attempt_sequence": {"type": "integer", "minimum": 0},
          "kind": {"type": "string", "minLength": 1},
          "message": {"type": "string"},
          "occurred_at": {"$ref": "#/components/schemas/Instant"}
        }
      },
      "JobEventPage": {
        "type": "object", "additionalProperties": false, "required": ["items", "next_since"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/JobEvent"}},
          "next_since": {"type": "string", "minLength": 1, "maxLength": 4096, "x-maxBytes": 4096}
        }
      },
      "EvidenceAvailability": {"type": "string", "enum": ["available", "missing", "tombstoned", "unavailable"]},
      "EvidenceReference": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "cell_id", "role", "digest_algorithm", "digest", "media_type", "size_bytes", "availability", "reason"],
        "properties": {
          "version": {"const": 1},
          "cell_id": {"type": ["string", "null"]},
          "role": {"type": "string", "minLength": 1},
          "digest_algorithm": {"type": ["string", "null"]},
          "digest": {"type": ["string", "null"]},
          "media_type": {"type": ["string", "null"]},
          "size_bytes": {"type": ["integer", "null"], "minimum": 0},
          "availability": {"$ref": "#/components/schemas/EvidenceAvailability"},
          "reason": {"type": ["string", "null"]}
        }
      },
      "JobEvidence": {
        "type": "object", "additionalProperties": false, "required": ["items"],
        "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/EvidenceReference"}}}
      },
      "PrincipalRequest": {"type": "object", "additionalProperties": false, "required": ["kind", "display_name", "issuer", "subject"], "properties": {"kind": {"type": "string", "enum": ["user", "service"]}, "display_name": {"type": "string"}, "issuer": {"type": "string"}, "subject": {"type": "string"}, "email": {"type": ["string", "null"]}, "active": {"type": "boolean", "default": true}}},
