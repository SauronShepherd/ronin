# Local Ronin appliance defaults. Replace every token before exposing the stack.
RONIN_TOKEN=change-me-local-token
RONIN_RUNNER_BROKER_TOKEN=change-me-runner-token
RONIN_AI_MODEL_DIR=./.ronin/models
RONIN_AI_VLLM_MODEL=local-model
POSTGRES_DB=ronin
POSTGRES_USER=ronin
POSTGRES_PASSWORD=change-me-postgres-password
